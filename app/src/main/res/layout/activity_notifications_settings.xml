<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page"
    android:orientation="vertical"
    tools:context=".NotificationsSettingsActivity">

    <TextView
        android:id="@+id/notificationsSettings_backArrow_iv"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_margin="10dp"
        android:clickable="true"
        android:drawableLeft="@drawable/ic_arrow_left"
        android:drawablePadding="5dp"
        android:fontFamily="@font/quicksand_bold"
        android:gravity="center"
        android:text="BACK"
        android:textColor="#000000"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <LinearLayout
            android:layout_width="380dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/quicksand_bold"
                android:text="NOTIFICATIONS SETTINGS"
                android:textColor="@color/primaryUI"
                android:textSize="28sp"
                android:textStyle="bold"
                android:gravity="center"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="380dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/quicksand_regular"
                    android:gravity="center_vertical"
                    android:text="Timer Notifications"
                    android:textColor="@color/primaryUI"
                    android:textSize="25sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/notificationsSettings_timerNotifications_sc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    app:thumbTint="@color/primaryUI"
                    app:trackTint="@color/scTrackTint" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/primaryUI" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/notificationsSettings_weekPlanNotifications_tv"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/quicksand_regular"
                    android:gravity="center_vertical"
                    android:text="Week Plan Notifications"
                    android:textColor="@color/primaryUI"
                    android:textSize="25sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/notificationsSettings_weekPlanNotifications_sc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    app:thumbTint="@color/primaryUI"
                    app:trackTint="@color/scTrackTint" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/primaryUI" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/notificationsSettings_breakfastNotifications_tv"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="@font/quicksand_regular"
                        android:gravity="center_vertical"
                        android:text="Breakfast Notifications"
                        android:textColor="@color/primaryUI"
                        android:textSize="25sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/notificationsSettings_breakfastNotifications_sc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        app:thumbTint="@color/primaryUI"
                        app:trackTint="@color/scTrackTint" />
                </LinearLayout>

                <TextView
                    android:id="@+id/notificationsSettings_breakfastHour_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:drawableStart="@drawable/ic_timer"
                    android:drawablePadding="6dp"
                    android:fontFamily="@font/quicksand_regular"
                    android:text="Change time: 08:00"
                    android:textColor="@color/primaryUI"
                    android:textSize="18sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/primaryUI" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/notificationsSettings_lunchNotifications_tv"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="@font/quicksand_regular"
                        android:gravity="center_vertical"
                        android:text="Lunch Notifications"
                        android:textColor="@color/primaryUI"
                        android:textSize="25sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/notificationsSettings_lunchNotifications_sc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        app:thumbTint="@color/primaryUI"
                        app:trackTint="@color/scTrackTint" />
                </LinearLayout>

                <TextView
                    android:id="@+id/notificationsSettings_lunchHour_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:drawableStart="@drawable/ic_timer"
                    android:drawablePadding="6dp"
                    android:fontFamily="@font/quicksand_regular"
                    android:text="Change time: 13:00"
                    android:textColor="@color/primaryUI"
                    android:textSize="18sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/primaryUI" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/notificationsSettings_dinnerNotifications_tv"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="@font/quicksand_regular"
                        android:gravity="center_vertical"
                        android:text="Dinner Notifications"
                        android:textColor="@color/primaryUI"
                        android:textSize="25sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/notificationsSettings_dinnerNotifications_sc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        app:thumbTint="@color/primaryUI"
                        app:trackTint="@color/scTrackTint" />
                </LinearLayout>

                <TextView
                    android:id="@+id/notificationsSettings_dinnerHour_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:drawableStart="@drawable/ic_timer"
                    android:drawablePadding="6dp"
                    android:fontFamily="@font/quicksand_regular"
                    android:text="Change time: 19:00"
                    android:textColor="@color/primaryUI"
                    android:textSize="18sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
