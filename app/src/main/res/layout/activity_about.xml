<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page"
    tools:context=".AboutActivity">

    <TextView
        android:id="@+id/about_backArrow_iv"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_margin="10dp"
        android:clickable="true"
        android:drawableLeft="@drawable/ic_arrow_left"
        android:drawablePadding="5dp"
        android:fontFamily="@font/quicksand_bold"
        android:gravity="center"
        android:text="BACK"
        android:textColor="#000000"
        android:textSize="20sp" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="70dp"
        android:paddingBottom="30dp">

        <LinearLayout
            android:layout_width="380dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/quicksand_bold"
                android:gravity="center"
                android:text="ABOUT"
                android:textColor="@color/primaryUI"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="380dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/quicksand_bold"
                android:text="About the Project"
                android:textColor="@color/primaryUI"
                android:textSize="24sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/quicksand_regular"
                android:lineSpacingExtra="4dp"
                android:text="Veganism is a recipe app made to help users discover vegan meals in one place. The app lets users browse recipes, save favorites, build a weekly meal plan, and manage helpful reminders for planned meals."
                android:textColor="@color/primaryUI"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/quicksand_regular"
                android:lineSpacingExtra="4dp"
                android:text="The goal of the app is to make vegan cooking feel easier, more organized, and more inviting for everyday use."
                android:textColor="@color/primaryUI"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="380dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/quicksand_bold"
                android:text="Bug Reports"
                android:textColor="@color/primaryUI"
                android:textSize="24sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/quicksand_regular"
                android:lineSpacingExtra="4dp"
                android:text="If you notice a bug or something in the app that does not work as expected, please contact me so I can improve it."
                android:textColor="@color/primaryUI"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/about_bugPhone_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:fontFamily="@font/quicksand_bold"
                android:text="+972 584261208"
                android:textColor="@color/primaryUI"
                android:textSize="22sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/quicksand_regular"
                android:text="Tap the number to open the messaging app."
                android:textColor="@color/primaryUI"
                android:textSize="16sp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
